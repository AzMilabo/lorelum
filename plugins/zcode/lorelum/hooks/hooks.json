{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "lore",
            "args": ["hook", "zcode"],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "process",
            "command": "lore",
            "args": ["hook", "zcode"],
            "timeoutMs": 10000
          }
        ]
      }
    ]
  }
}
